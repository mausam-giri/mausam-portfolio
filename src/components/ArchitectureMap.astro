---
// ArchitectureMap.astro - Interactive Production Architecture Blueprint
---

<div class="arch-map-wrapper">
  <div class="arch-controls">
    <div class="arch-controls-label">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span>SYSTEM BLUEPRINTS:</span>
    </div>
    <div class="arch-tabs" role="tablist">
      <button type="button" class="arch-tab active" data-target="payment-arch" role="tab">
        1. Multi-Gateway Payment Rails
      </button>
      <button type="button" class="arch-tab" data-target="ehr-arch" role="tab">
        2. Clinical EHR & Diagnostics
      </button>
      <button type="button" class="arch-tab" data-target="worldskills-arch" role="tab">
        3. WorldSkills Zero-Failure Mesh
      </button>
    </div>
  </div>

  <!-- Panel 1: Payment Architecture -->
  <div class="arch-panel active" id="payment-arch" role="tabpanel">
    <div class="arch-diagram-grid">
      <div class="arch-node">
        <span class="node-tag">ENTRY</span>
        <h4>Client Checkout</h4>
        <p>Web / Mobile App (Next.js & React Native)</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight">
        <span class="node-tag">SECURITY & ROUTING</span>
        <h4>AWS API Gateway</h4>
        <p>mTLS, Token Verification, Rate Limiting</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight-gold">
        <span class="node-tag">ORCHESTRATOR</span>
        <h4>Payment Core Service</h4>
        <p>Idempotency, Fallback Routing, Zero State Loss</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node-multi">
        <div class="sub-node">
          <span class="node-tag-sm">GLOBAL</span>
          <strong>Stripe Connect</strong>
        </div>
        <div class="sub-node">
          <span class="node-tag-sm">DOMESTIC</span>
          <strong>Razorpay</strong>
        </div>
        <div class="sub-node">
          <span class="node-tag-sm">FX / MULTI-CURRENCY</span>
          <strong>Airwallex</strong>
        </div>
      </div>
    </div>
    <div class="arch-caption">
      <span class="caption-badge">FAILURE TOLERANCE</span>
      <span>Automated circuit-breakers reroute transactions seamlessly upon downstream gateway timeouts. SQS Dead-Letter Queues guarantee asynchronous reconciliation.</span>
    </div>
  </div>

  <!-- Panel 2: EHR & Diagnostics -->
  <div class="arch-panel" id="ehr-arch" role="tabpanel" style="display: none;">
    <div class="arch-diagram-grid">
      <div class="arch-node">
        <span class="node-tag">CLINICAL USERS</span>
        <h4>Doctors & Patients</h4>
        <p>20,000+ Electronic Health Records</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight">
        <span class="node-tag">CONTAINER FLEET</span>
        <h4>Amazon EKS Workloads</h4>
        <p>Autoscaling pods, RBAC token verification</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight-gold">
        <span class="node-tag">PERSISTENCE</span>
        <h4>Encrypted Database</h4>
        <p>HIPAA compliant, KMS envelope encryption</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node-multi">
        <div class="sub-node">
          <span class="node-tag-sm">LAB DISPATCH</span>
          <strong>Tata 1mg</strong>
        </div>
        <div class="sub-node">
          <span class="node-tag-sm">LAB DISPATCH</span>
          <strong>Healthians</strong>
        </div>
        <div class="sub-node">
          <span class="node-tag-sm">LAB DISPATCH</span>
          <strong>Redcliffe Labs</strong>
        </div>
      </div>
    </div>
    <div class="arch-caption">
      <span class="caption-badge">DATA GOVERNANCE</span>
      <span>Role-based access control enforces strict doctor-patient boundary isolation. Real-time webhooks dispatch lab requisitions with automated retry policies.</span>
    </div>
  </div>

  <!-- Panel 3: WorldSkills Topology -->
  <div class="arch-panel" id="worldskills-arch" role="tabpanel" style="display: none;">
    <div class="arch-diagram-grid">
      <div class="arch-node">
        <span class="node-tag">GLOBAL DNS</span>
        <h4>Amazon Route 53</h4>
        <p>Latency-based geo-routing & health checks</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight">
        <span class="node-tag">EDGE SECURITY</span>
        <h4>CloudFront + WAF</h4>
        <p>DDoS mitigation, SSL termination</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node highlight-gold">
        <span class="node-tag">SERVICE MESH</span>
        <h4>Amazon VPC Lattice</h4>
        <p>Cross-account private interconnect without complex peering</p>
      </div>
      <div class="arch-flow-arrow">→</div>
      <div class="arch-node">
        <span class="node-tag">ZERO FAILURE</span>
        <h4>Multi-AZ Kubernetes</h4>
        <p>Self-healing pods, Prometheus telemetry</p>
      </div>
    </div>
    <div class="arch-caption">
      <span class="caption-badge">INTERNATIONAL GOLD</span>
      <span>Executed under strict timed countdowns at Global Skills Challenge Australia 2026. Zero drift, 100% declarative Terraform architecture.</span>
    </div>
  </div>
</div>

<style>
  .arch-map-wrapper {
    background: var(--bg-surface);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    padding: 2rem;
    margin: 2.5rem 0 4.5rem;
    box-shadow: var(--shadow-md);
  }

  .arch-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    border-bottom: 1px solid var(--border-subtle);
    padding-bottom: 1.25rem;
    margin-bottom: 1.75rem;
  }

  .arch-controls-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .arch-tabs {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .arch-tab {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .arch-tab:hover {
    color: var(--text-primary);
    border-color: var(--border-medium);
  }

  .arch-tab.active {
    background: var(--bg-elevated);
    color: var(--accent-gold);
    border-color: var(--border-focus);
    box-shadow: 0 0 12px var(--accent-gold-glow);
  }

  .arch-diagram-grid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 1rem 0.5rem;
  }

  .arch-node {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.25rem 1rem;
    min-width: 170px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    text-align: left;
    transition: all var(--transition-fast);
  }

  .arch-node.highlight {
    border-color: rgba(56, 189, 248, 0.4);
    background: linear-gradient(180deg, rgba(56, 189, 248, 0.05), var(--bg-secondary));
  }

  .arch-node.highlight-gold {
    border-color: rgba(245, 158, 11, 0.5);
    background: linear-gradient(180deg, rgba(245, 158, 11, 0.08), var(--bg-secondary));
  }

  .node-tag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent-gold);
    letter-spacing: 0.08em;
  }

  .arch-node h4 {
    font-size: 0.95rem;
    font-weight: 700;
    color: var(--text-primary);
  }

  .arch-node p {
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.4;
  }

  .arch-flow-arrow {
    color: var(--text-muted);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .arch-node-multi {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-width: 170px;
  }

  .sub-node {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-sm);
    padding: 0.55rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .node-tag-sm {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent-blue);
  }

  .sub-node strong {
    font-size: 0.82rem;
    color: var(--text-primary);
  }

  .arch-caption {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }

  .caption-badge {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    background: rgba(245, 158, 11, 0.12);
    color: var(--accent-gold-light);
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    white-space: nowrap;
  }

  @media (max-width: 900px) {
    .arch-diagram-grid {
      flex-direction: column;
      align-items: stretch;
    }
    .arch-flow-arrow {
      text-align: center;
      transform: rotate(90deg);
      margin: 0.25rem 0;
    }
  }
</style>

<script>
  const tabs = document.querySelectorAll('.arch-tab');
  const panels = document.querySelectorAll('.arch-panel');

  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      panels.forEach(p => {
        (p as HTMLElement).style.display = 'none';
        p.classList.remove('active');
      });

      tab.classList.add('active');
      const targetId = tab.getAttribute('data-target');
      if (targetId) {
        const targetPanel = document.getElementById(targetId);
        if (targetPanel) {
          targetPanel.style.display = 'block';
          targetPanel.classList.add('active');
        }
      }
    });
  });
</script>
