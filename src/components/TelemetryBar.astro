---
// TelemetryBar.astro - Live operational pulse & recruiter status
---

<div class="telemetry-strip" id="telemetry-bar">
  <div class="container telemetry-inner">
    <div class="pulse-indicator">
      <span class="pulse-dot" aria-hidden="true"></span>
      <span><strong>STATUS:</strong> OPEN TO SENIOR / STAFF CLOUD & SYSTEMS ROLES</span>
    </div>

    <div class="telemetry-metrics">
      <div class="metric-item">
        <span>BASE:</span> <strong>NEW DELHI / REMOTE</strong>
      </div>
      <div class="metric-item">
        <span>LOCAL TIME:</span> <strong id="live-ist-clock">--:--:-- IST</strong>
      </div>
      <div class="metric-item" id="latency-indicator">
        <span>LATENCY:</span> <strong id="ping-value">12ms</strong>
      </div>
    </div>
  </div>
</div>

<script>
  function updateTime() {
    const clock = document.getElementById('live-ist-clock');
    if (clock) {
      const now = new Date();
      const options: Intl.DateTimeFormatOptions = {
        timeZone: 'Asia/Kolkata',
        hour: '2-digit',
        minute: '2-digit',
        second: '2-digit',
        hour12: false
      };
      clock.textContent = `${new Intl.DateTimeFormat('en-GB', options).format(now)} IST`;
    }
  }

  // Update clock every second
  updateTime();
  setInterval(updateTime, 1000);

  // Measure subtle dynamic ping
  if (typeof window !== 'undefined') {
    const pingEl = document.getElementById('ping-value');
    if (pingEl && window.performance) {
      const timing = window.performance.timing;
      const latency = timing ? Math.max(8, timing.responseEnd - timing.requestStart) : 14;
      pingEl.textContent = `${Math.min(latency, 45)}ms`;
    }
  }
</script>
