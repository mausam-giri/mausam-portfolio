---
// index.astro - Flagship Executive Landing Page
import BaseLayout from '../layouts/BaseLayout.astro';
import ArchitectureMap from '../components/ArchitectureMap.astro';
---

<BaseLayout 
  title="Mausam Giri — Cloud Systems Architect & WorldSkills Olympian"
  description="Cloud Computing-focused Software Engineer. Gold Medalist at Global Skills Challenge Australia 2026, Team India at WorldSkills Shanghai 2026. Scaling production healthcare EHRs & payment orchestration at MantraCare."
>
  <!-- HERO SECTION -->
  <section class="hero-section" id="hero">
    <div class="container hero-content">
      <div class="hero-accolade-badge">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"></polygon>
        </svg>
        <span>Global Skills Challenge Australia 2026 Gold Medalist • Team India WorldSkills Shanghai</span>
      </div>

      <h1 class="hero-headline">
        Cloud Systems Architect. <br />
        <span class="text-highlight">Production Tested Under Fire.</span>
      </h1>

      <p class="hero-lead">
        I am <strong>Mausam Kumar Giri</strong>, a software engineer operating at the convergence of high-stakes cloud architecture and high-throughput production systems. I proved my architectural speed and determinism representing India on the world stage—and I bring that exact zero-failure rigor to scaling healthcare EHRs and fintech payment infrastructure.
      </p>

      <div class="hero-actions">
        <a href="/resume" class="btn-primary" id="hero-resume-cta">
          <span>Review Executive Dossier</span>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>

        <a href="#systems" class="btn-secondary" id="hero-systems-cta">
          <span>Inspect Architecture Blueprints</span>
        </a>

        <a href="mailto:personal.mausamgiri@gmail.com?subject=Senior%20/%20Staff%20Engineering%20Role" class="btn-secondary" id="hero-email-cta">
          <span>Connect Directly</span>
        </a>
      </div>
    </div>
  </section>

  <!-- PRODUCTION HARD METRICS RIBBON -->
  <section class="container" aria-label="Production Performance Metrics">
    <div class="metrics-ribbon">
      <div class="stat-item">
        <div class="stat-number">20,000<span>+</span></div>
        <div class="stat-label">Patient Health Records</div>
        <div class="stat-detail">Role-based access & HIPAA privacy at MantraCare</div>
      </div>

      <div class="stat-item">
        <div class="stat-number">3<span> Rails</span></div>
        <div class="stat-label">Unified Payment Orchestration</div>
        <div class="stat-detail">Stripe Connect • Razorpay • Airwallex with zero state loss</div>
      </div>

      <div class="stat-item">
        <div class="stat-number">50,000<span>+</span></div>
        <div class="stat-label">Active Platform Users</div>
        <div class="stat-detail">Real-time engagement telemetry & clinical pathways</div>
      </div>

      <div class="stat-item">
        <div class="stat-number">#1<span> Gold</span></div>
        <div class="stat-label">International Cloud Champion</div>
        <div class="stat-detail">Global Skills Challenge Australia 2026 (Wollongong)</div>
      </div>
    </div>
  </section>

  <!-- WORLD & NATIONAL SKILLS COMPETITIONS PROOF STRIP -->
  <section class="container proof-strip" id="competitions">
    <div class="proof-header">
      <div>
        <span class="section-tag">THE PROVING GROUND</span>
        <h2 class="section-title">International & National Arena</h2>
      </div>
      <p class="section-desc">
        Competitive cloud engineering under stopwatch conditions where a single networking glitch or misconfigured security group drops points.
      </p>
    </div>

    <div class="proof-grid">
      <!-- Australia Gold -->
      <article class="proof-card featured">
        <div class="proof-card-top">
          <span class="medal-badge gold">Gold Medalist</span>
          <span class="proof-year">June 2026</span>
        </div>
        <h3 class="proof-card-title">Global Skills Challenge Australia</h3>
        <div class="proof-card-sub">Wollongong, New South Wales • Cloud Computing</div>
        <p class="proof-card-body">
          Finished 1st internationally against top national champions. Executed end-to-end multi-AZ AWS cloud infrastructure, advanced container networking, and disaster recovery under strict time pressure.
        </p>
        <a href="https://worldskills.org.au" target="_blank" rel="noopener noreferrer" class="proof-verification">
          <span>Verified via WorldSkills Australia</span> →
        </a>
      </article>

      <!-- WorldSkills Shanghai -->
      <article class="proof-card">
        <div class="proof-card-top">
          <span class="medal-badge gold">Team India</span>
          <span class="proof-year">2026</span>
        </div>
        <h3 class="proof-card-title">WorldSkills Shanghai 2026</h3>
        <div class="proof-card-sub">The 48th WorldSkills Competition • Cloud Computing</div>
        <p class="proof-card-body">
          Represented India on the premier global stage for technical excellence. Evaluated on real-time infrastructure troubleshooting, Kubernetes deployment topologies, and high-availability systems.
        </p>
        <a href="https://pib.gov.in" target="_blank" rel="noopener noreferrer" class="proof-verification">
          <span>Official Press Release (PIB India)</span> →
        </a>
      </article>

      <!-- IndiaSkills National Gold -->
      <article class="proof-card">
        <div class="proof-card-top">
          <span class="medal-badge gold">National Gold</span>
          <span class="proof-year">2026</span>
        </div>
        <h3 class="proof-card-title">WorldSkills India Nationals</h3>
        <div class="proof-card-sub">IndiaSkills 2026 • AWS Cloud Computing</div>
        <p class="proof-card-body">
          Ranked #1 nationwide across rigorous multi-day cloud challenges spanning VPC architectures, IAM least privilege, serverless pipelines, and containerized microservice orchestrations.
        </p>
        <span class="proof-verification">National Championship Certified</span>
      </article>

      <!-- IndiaSkills Bronze -->
      <article class="proof-card">
        <div class="proof-card-top">
          <span class="medal-badge bronze">National Bronze</span>
          <span class="proof-year">2024</span>
        </div>
        <h3 class="proof-card-title">WorldSkills India Nationals</h3>
        <div class="proof-card-sub">IndiaSkills 2024 • Web Technologies</div>
        <p class="proof-card-body">
          Represented Bihar and won Bronze on the national stage, demonstrating full-stack engineering speed, interactive client systems, and responsive architectural standards.
        </p>
        <span class="proof-verification">National Finalist</span>
      </article>
    </div>
  </section>

  <!-- INTERACTIVE ARCHITECTURE BLUEPRINT -->
  <section class="container" id="systems">
    <div class="proof-header">
      <div>
        <span class="section-tag">HOW I ARCHITECT</span>
        <h2 class="section-title">Zero-Failure System Topologies</h2>
      </div>
      <p class="section-desc">
        Interactive architectural schematics showcasing how data flows, fallbacks trigger, and security boundaries are maintained in production.
      </p>
    </div>

    <ArchitectureMap />
  </section>

  <!-- SIGNATURE ENGINEERING STORIES (NO GENERIC PROJECT CARDS) -->
  <section class="container stories-section" id="stories">
    <div class="proof-header">
      <div>
        <span class="section-tag">PRODUCTION CASE STUDIES</span>
        <h2 class="section-title">Engineered Evidence, Not Résumé Bullets</h2>
      </div>
      <p class="section-desc">
        Deep narratives documenting technical trade-offs, catastrophic failure prevention, and measurable production impact.
      </p>
    </div>

    <div class="stories-list">
      <!-- Story 1: Payment Rails -->
      <article class="story-item">
        <div class="story-meta-bar">
          <span class="story-context">FINTECH & DISTRIBUTED SYSTEMS</span>
          <span>•</span>
          <span>MANTRACARE HEALTH</span>
          <span>•</span>
          <span>PRODUCTION</span>
        </div>
        <h3 class="story-title">The Rails: Multi-Provider Payment Orchestration with Zero State Loss</h3>
        <p class="story-narrative">
          Operating a global healthcare marketplace requires accepting domestic payments in India while seamlessly supporting international cross-border consultations. Relying on a single payment processor exposed the platform to regional gateway outages, currency settlement overhead, and lost transactions.
          <br /><br />
          I architected a unified payment orchestration layer integrating <strong>Stripe Connect, Razorpay, and Airwallex</strong>. The system employs automated idempotency keys in Redis, intelligent routing based on buyer currency and card scheme, and asynchronous dead-letter reconciliation queues to guarantee zero double-charges and zero lost payments.
        </p>

        <div class="story-pillars">
          <div class="pillar-item">
            <span class="pillar-label">GATEWAY ROUTING</span>
            <span class="pillar-val">Stripe Connect + Razorpay + Airwallex</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">RELIABILITY METRIC</span>
            <span class="pillar-val">99.98% Transaction Uptime</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">RECONCILIATION</span>
            <span class="pillar-val">Asynchronous SQS Webhook Workers</span>
          </div>
        </div>

        <div class="story-footer">
          <span class="story-architecture-tag">ARCH: API Gateway • Node.js / TypeScript • Redis • DynamoDB • SQS</span>
          <a href="/works#payments" class="story-deepdive-link">
            <span>Read Architecture Deep Dive</span> →
          </a>
        </div>
      </article>

      <!-- Story 2: Clinical EHR -->
      <article class="story-item">
        <div class="story-meta-bar">
          <span class="story-context">HEALTHCARE INFRASTRUCTURE</span>
          <span>•</span>
          <span>MANTRACARE HEALTH</span>
          <span>•</span>
          <span>PRODUCTION</span>
        </div>
        <h3 class="story-title">The Vault: Scaling an EHR & Diagnostics Pipeline for 20,000+ Human Stories</h3>
        <p class="story-narrative">
          Electronic Health Records cannot tolerate eventual consistency errors or security compromises. Doctors across multiple states required multilingual consultation note templates, while patients needed instant dispatch of clinical lab tests to accredited national diagnostic laboratories.
          <br /><br />
          I designed and shipped the core EHR engine serving over <strong>20,000 patient histories</strong> with field-level encryption, role-based access boundaries (RBAC), and direct API integrations dispatching orders to <strong>Tata 1mg, Healthians, and Redcliffe Labs</strong> with automated fulfillment telemetry.
        </p>

        <div class="story-pillars">
          <div class="pillar-item">
            <span class="pillar-label">PATIENT BASE</span>
            <span class="pillar-val">20,000+ Encrypted Records</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">LAB INTEGRATIONS</span>
            <span class="pillar-val">Tata 1mg, Healthians, Redcliffe</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">SECURITY POSTURE</span>
            <span class="pillar-val">HIPAA RBAC & KMS Envelope Encryption</span>
          </div>
        </div>

        <div class="story-footer">
          <span class="story-architecture-tag">ARCH: Amazon EKS • PostgreSQL • KMS • Docker • Express.js</span>
          <a href="/works#ehr" class="story-deepdive-link">
            <span>Read Architecture Deep Dive</span> →
          </a>
        </div>
      </article>

      <!-- Story 3: Australia Arena -->
      <article class="story-item">
        <div class="story-meta-bar">
          <span class="story-context">WORLDSKILLS INTERNATIONAL</span>
          <span>•</span>
          <span>WOLLONGONG, AUSTRALIA</span>
          <span>•</span>
          <span>COMPETITIVE ARENA</span>
        </div>
        <h3 class="story-title">The Arena: 180 Minutes to Build a Bulletproof Cloud Under Stopwatch Pressure</h3>
        <p class="story-narrative">
          At the Global Skills Challenge in Australia, international competitors were given rigorous infrastructure test projects: deploy multi-tier architectures, isolate networks across VPCs with strict routing policies, automate auto-scaling Kubernetes workloads, and rapidly recover services from simulated hardware crashes.
          <br /><br />
          Winning <strong>International Gold</strong> required eliminating all manual GUI clicking in favor of deterministic scripts, declarative Terraform manifests, and an intimate understanding of AWS VPC networking, IAM security policies, and Linux kernel diagnostics under adversarial grading.
        </p>

        <div class="story-pillars">
          <div class="pillar-item">
            <span class="pillar-label">OUTCOME</span>
            <span class="pillar-val">International Gold Medal (1st Place)</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">DISCIPLINE</span>
            <span class="pillar-val">AWS Cloud Architecture & SRE</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">METHODOLOGY</span>
            <span class="pillar-val">100% Declarative Infrastructure-as-Code</span>
          </div>
        </div>

        <div class="story-footer">
          <span class="story-architecture-tag">STACK: AWS VPC Lattice • EKS • Route 53 • Terraform • Helm • Prometheus</span>
          <a href="/works#worldskills" class="story-deepdive-link">
            <span>Read Competition Retrospective</span> →
          </a>
        </div>
      </article>

      <!-- Story 4: NIT Kurukshetra ML Research -->
      <article class="story-item">
        <div class="story-meta-bar">
          <span class="story-context">MACHINE LEARNING RESEARCH</span>
          <span>•</span>
          <span>NIT KURUKSHETRA</span>
          <span>•</span>
          <span>RESEARCH INTERN</span>
        </div>
        <h3 class="story-title">The Latent Space: Overcoming the Cold-Start Dilemma with Transformers</h3>
        <p class="story-narrative">
          Collaborative filtering recommendation algorithms collapse when encountering zero-history users. During my research internship at NIT Kurukshetra, I investigated bridging disparate data domains by projecting item metadata into shared cross-domain latent spaces using transformer embeddings.
          <br /><br />
          I developed a novel cross-domain recommendation model that evaluates semantic similarity across datasets, providing high-accuracy zero-shot recommendations for newly onboarded entities, accompanied by an interactive benchmarking workbench.
        </p>

        <div class="story-pillars">
          <div class="pillar-item">
            <span class="pillar-label">RESEARCH TARGET</span>
            <span class="pillar-val">Cold-Start Recommendation Solving</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">APPROACH</span>
            <span class="pillar-val">Cross-Domain Transformer Embeddings</span>
          </div>
          <div class="pillar-item">
            <span class="pillar-label">CODE ARTIFACT</span>
            <span class="pillar-val">mausam-giri/cross_recommendation_system</span>
          </div>
        </div>

        <div class="story-footer">
          <span class="story-architecture-tag">RESEARCH: Python • PyTorch • HuggingFace Transformers • Flask Benchmark UI</span>
          <a href="https://github.com/mausam-giri/cross_recommendation_system" target="_blank" rel="noopener noreferrer" class="story-deepdive-link">
            <span>Inspect GitHub Repository</span> →
          </a>
        </div>
      </article>
    </div>
  </section>

  <!-- EXECUTIVE CAPABILITY MATRIX (ZERO GENERIC SKILL CHIPS) -->
  <section class="container matrix-section" id="capabilities">
    <div class="proof-header">
      <div>
        <span class="section-tag">ENGINEERING DOMAINS</span>
        <h2 class="section-title">Executive Capability Matrix</h2>
      </div>
      <p class="section-desc">
        No generic skill tag clouds or floating chips. Every capability is anchored in production infrastructure, scalability metrics, and competitive validation.
      </p>
    </div>

    <div class="matrix-grid">
      <!-- Domain 1: Cloud & Infrastructure -->
      <div class="matrix-domain-card">
        <div class="domain-header">
          <div class="domain-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path>
            </svg>
          </div>
          <h3 class="domain-name">Cloud & Distributed Systems</h3>
        </div>
        <p class="domain-summary">
          Architecting resilient, multi-region AWS environments tested under international competition standards and production high availability.
        </p>
        <ul class="domain-specs">
          <li class="domain-spec-item">
            <span class="spec-category">CONTAINER ORCHESTRATION</span>
            <span class="spec-evidence">Amazon EKS, Kubernetes, Helm, Argo CD, Zero-Drift Rollouts</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">CLOUD NETWORKING</span>
            <span class="spec-evidence">VPC Peering, VPC Lattice, Transit Gateways, Route 53, PrivateLink</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">INFRASTRUCTURE AS CODE</span>
            <span class="spec-evidence">Terraform, Docker, GitHub Actions CI/CD, Immutable AMIs</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">SECURITY & OBSERVABILITY</span>
            <span class="spec-evidence">IAM Least-Privilege, KMS Envelope Encryption, Prometheus, Grafana</span>
          </li>
        </ul>
      </div>

      <!-- Domain 2: Fintech & Backend Reliability -->
      <div class="matrix-domain-card">
        <div class="domain-header">
          <div class="domain-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
              <line x1="1" y1="10" x2="23" y2="10"></line>
            </svg>
          </div>
          <h3 class="domain-name">Fintech & Transaction Reliability</h3>
        </div>
        <p class="domain-summary">
          Building resilient financial routing mechanisms where double-charges and unacknowledged states are mathematically impossible.
        </p>
        <ul class="domain-specs">
          <li class="domain-spec-item">
            <span class="spec-category">PAYMENT GATEWAYS</span>
            <span class="spec-evidence">Stripe Connect, Razorpay, Airwallex Multi-Currency Rails</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">TRANSACTION INTEGRITY</span>
            <span class="spec-evidence">Idempotent request keys, distributed locks via Redis, SQS Dead-Letters</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">DATA STORES</span>
            <span class="spec-evidence">PostgreSQL, DynamoDB (Single-Table Design), Redis Pub/Sub</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">API DESIGN</span>
            <span class="spec-evidence">RESTful microservices, GraphQL, WebSocket real-time event delivery</span>
          </li>
        </ul>
      </div>

      <!-- Domain 3: Systems Polish & UI Precision -->
      <div class="matrix-domain-card">
        <div class="domain-header">
          <div class="domain-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="16 18 22 12 16 6"></polyline>
              <polyline points="8 6 2 12 8 18"></polyline>
            </svg>
          </div>
          <h3 class="domain-name">Full-Spectrum Systems Polish</h3>
        </div>
        <p class="domain-summary">
          Deep appreciation for the entire execution path—from Linux kernel sockets down to browser paint cycles and layout stability.
        </p>
        <ul class="domain-specs">
          <li class="domain-spec-item">
            <span class="spec-category">LAYOUT STABILITY</span>
            <span class="spec-evidence">Solved Radix UI scrollbar shift bug (#1925), zero CLS guarantees</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">CLIENT COMPUTING</span>
            <span class="spec-evidence">Web Workers for dynamic PDF compilation offloading main thread</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">FRAMEWORKS</span>
            <span class="spec-evidence">React, Next.js, Astro, React Native, Canvas & SVG APIs</span>
          </li>
          <li class="domain-spec-item">
            <span class="spec-category">PERFORMANCE</span>
            <span class="spec-evidence">100/100 Core Web Vitals, asset minification, sub-50ms TTFB</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- RECRUITER INSTANT ACTION / HIRE ME BANNER -->
  <section class="container" id="contact">
    <div class="recruiter-cta-banner">
      <div class="recruiter-cta-content">
        <span class="section-tag">TAKE DIRECT ACTION</span>
        <h2 class="recruiter-cta-title">Looking for an engineer who thrives when the pressure peaks?</h2>
        <p class="recruiter-cta-desc">
          Whether you need a <strong>Senior Cloud Systems Engineer</strong> to harden distributed infrastructure or a <strong>Lead Full-Stack Architect</strong> to engineer resilient financial and healthcare platforms, let's connect.
        </p>

        <div class="recruiter-action-row">
          <a href="/resume" class="btn-primary" id="banner-dossier-btn">
            <span>View Executive Dossier</span>
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </a>

          <button type="button" class="quick-contact-pill" id="copy-email-btn" title="Click to copy email address">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
              <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
            </svg>
            <span id="copy-email-text">personal.mausamgiri@gmail.com</span>
          </button>

          <a href="tel:+918789120560" class="quick-contact-pill">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span>+91 8789120560</span>
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Copy Email Functionality with Feedback
  const copyBtn = document.getElementById('copy-email-btn');
  const copyText = document.getElementById('copy-email-text');

  copyBtn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText('personal.mausamgiri@gmail.com');
      if (copyText) {
        const original = copyText.textContent;
        copyText.textContent = '✓ Copied to clipboard!';
        setTimeout(() => {
          copyText.textContent = original;
        }, 2500);
      }
    } catch (err) {
      console.error('Failed to copy: ', err);
    }
  });
</script>
