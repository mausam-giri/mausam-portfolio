---
// resume.astro - Dedicated Executive Dossier & Printable Resume
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Executive Dossier & Resume — Mausam Kumar Giri"
  description="Executive technical resume of Mausam Kumar Giri. Software Engineer & Cloud Systems Architect. Gold Medalist at Global Skills Challenge Australia 2026. Verified AWS skills profile and credentials."
>
  <div class="container">
    <div class="page-header no-print">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 1.5rem;">
        <div>
          <span class="section-tag">CURRICULUM VITAE</span>
          <h1 class="section-title">Executive Dossier</h1>
          <p class="section-desc">
            Standardized, ATS-compliant technical record. Direct verification links to credential issuers and international competition bodies.
          </p>
        </div>

        <div style="display: flex; gap: 0.75rem; align-items: center;">
          <button type="button" class="btn-primary" id="print-resume-btn" onclick="window.print()">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 6 2 18 2 18 9"></polyline>
              <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path>
              <rect x="6" y="14" width="12" height="8"></rect>
            </svg>
            <span>Print / Save as PDF</span>
          </button>
        </div>
      </div>
    </div>

    <!-- MAIN RESUME DOCUMENT -->
    <main class="resume-container" id="resume-document">
      <!-- HEADER -->
      <header style="border-bottom: 2px solid var(--border-medium); padding-bottom: 2rem; margin-bottom: 2.5rem;">
        <h2 style="font-size: 2.2rem; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 0.35rem; color: var(--text-primary);">
          MAUSAM KUMAR GIRI
        </h2>
        <div style="font-size: 1.05rem; font-weight: 600; color: var(--accent-gold); margin-bottom: 0.75rem;">
          Cloud Computing Architect • AWS Specialist • Production Software Engineer
        </div>
        <div style="display: flex; flex-wrap: wrap; gap: 1.25rem; font-family: var(--font-mono); font-size: 0.85rem; color: var(--text-secondary);">
          <span>New Delhi & Bihar, India</span>
          <span>•</span>
          <a href="mailto:personal.mausamgiri@gmail.com" style="color: var(--accent-blue);">personal.mausamgiri@gmail.com</a>
          <span>•</span>
          <a href="tel:+918789120560">+91 8789120560</a>
          <span>•</span>
          <a href="https://mausamgiri.in" target="_blank" rel="noopener noreferrer">mausamgiri.in</a>
        </div>
      </header>

      <!-- EXECUTIVE SUMMARY -->
      <section class="resume-section">
        <h3 class="resume-section-title">EXECUTIVE SUMMARY</h3>
        <p style="font-size: 0.95rem; color: var(--text-secondary); line-height: 1.7;">
          Cloud Computing-focused Software Engineer with deep hands-on AWS and high-throughput production engineering experience. Represented India in Cloud Computing at <strong>WorldSkills Shanghai 2026</strong>; <strong>Gold Medalist</strong> in Cloud Computing at the <strong>Global Skills Challenge Australia 2026</strong> and <strong>WorldSkills India Nationals 2026</strong>. Combines high-pressure architectural speed with battle-tested production reliability across healthcare EHRs, payment orchestration, and distributed cloud infrastructure.
        </p>
      </section>

      <!-- WORLD & NATIONAL SKILLS COMPETITIONS -->
      <section class="resume-section">
        <h3 class="resume-section-title">WORLD & NATIONAL SKILLS COMPETITIONS</h3>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Cloud Computing Competitor (Team India)</span> — <span class="resume-org">WorldSkills Shanghai 2026</span>
            </div>
            <span class="resume-period">2026</span>
          </div>
          <ul class="resume-bullets">
            <li>Represented India on the premier global technical stage, competing against top national champions.</li>
            <li>Executed complex AWS cloud infrastructure, microservices networking, container orchestration, and high-availability topologies under strict timed evaluation.</li>
          </ul>
        </div>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Gold Medalist — Cloud Computing</span> — <span class="resume-org">Global Skills Challenge Australia 2026</span>
            </div>
            <span class="resume-period">June 2026 | Wollongong, NSW</span>
          </div>
          <ul class="resume-bullets">
            <li>Secured 1st Place internationally in AWS cloud architecture, rapid infrastructure deployment, and live fault recovery.</li>
            <li>Official verification: <a href="https://worldskills.org.au" target="_blank" rel="noopener noreferrer" style="color: var(--accent-gold);">WorldSkills Australia Official</a></li>
          </ul>
        </div>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Gold Medalist — AWS Cloud Computing</span> — <span class="resume-org">WorldSkills India Nationals (IndiaSkills)</span>
            </div>
            <span class="resume-period">2026</span>
          </div>
          <ul class="resume-bullets">
            <li>Ranked #1 in India for AWS Cloud infrastructure design, VPC network isolation, and declarative automation.</li>
          </ul>
        </div>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Bronze Medalist — Web Technologies</span> — <span class="resume-org">WorldSkills India Nationals (IndiaSkills)</span>
            </div>
            <span class="resume-period">2024</span>
          </div>
          <ul class="resume-bullets">
            <li>Represented Bihar and won 3rd place nationally for full-stack engineering speed, interactive client systems, and responsive design.</li>
          </ul>
        </div>
      </section>

      <!-- PROFESSIONAL EXPERIENCE -->
      <section class="resume-section">
        <h3 class="resume-section-title">PROFESSIONAL EXPERIENCE</h3>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Software Engineer</span> — <span class="resume-org">MantraCare Health Pvt. Ltd</span>
            </div>
            <span class="resume-period">Feb 2025 – Present | New Delhi, India</span>
          </div>
          <ul class="resume-bullets">
            <li>Architected and delivered an Electronic Health Record (EHR) platform managing <strong>20,000+ patient records</strong>, featuring multilingual consultation note templates, insurance pathways, and granular role-based access control (RBAC).</li>
            <li>Engineered a unified multi-provider payment orchestration gateway integrating <strong>Stripe Connect, Razorpay, and Airwallex</strong> with automated reconciliation and zero state-loss transaction recovery.</li>
            <li>Integrated direct clinical order dispatch and diagnostics pipelines with <strong>Healthians, Redcliffe Labs, and Tata 1mg</strong>, enabling seamless in-app lab test bookings.</li>
            <li>Spearheaded a reward-based health engagement engine serving <strong>50,000+ active users</strong> with real-time activity telemetry and customized clinical habit pathways (+20% sustained engagement).</li>
            <li>Managed cloud infrastructure, container deployments, and production incident response across Node.js, TypeScript, PostgreSQL, and AWS.</li>
          </ul>
        </div>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Machine Learning Research Intern</span> — <span class="resume-org">National Institute of Technology (NIT), Kurukshetra</span>
            </div>
            <span class="resume-period">June 2024 – August 2024 | Haryana, India</span>
          </div>
          <ul class="resume-bullets">
            <li>Engineered a transformer-based cross-domain recommendation system resolving the classic recommendation "cold-start" problem via semantic embedding similarity across multi-domain datasets.</li>
            <li>Developed an interactive evaluation and diagnostic web dashboard for cross-domain recommendation benchmarking.</li>
            <li>Open source artifact: <a href="https://github.com/mausam-giri/cross_recommendation_system" target="_blank" rel="noopener noreferrer" style="color: var(--accent-blue);">github.com/mausam-giri/cross_recommendation_system</a></li>
          </ul>
        </div>

        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Frontend Web Development Intern</span> — <span class="resume-org">Estrome Technologies Pvt. Ltd</span>
            </div>
            <span class="resume-period">June 2023 – August 2023 | Lucknow, India</span>
          </div>
          <ul class="resume-bullets">
            <li>Developed an enterprise analytics and lead management portal with client-side dynamic PDF compilation using background Web Workers to maintain 60 FPS UI responsiveness.</li>
            <li>Improved Core Web Vitals and organic SEO metrics by approximately 30%.</li>
          </ul>
        </div>
      </section>

      <!-- EDUCATION -->
      <section class="resume-section">
        <h3 class="resume-section-title">EDUCATION</h3>
        <div class="resume-entry">
          <div class="resume-entry-header">
            <div>
              <span class="resume-role">Bachelor of Technology (B.Tech) in Computer Science and Engineering</span>
            </div>
            <span class="resume-period">2021 – 2025</span>
          </div>
          <div style="font-weight: 600; color: var(--text-primary); margin-bottom: 0.25rem;">
            Central University of Haryana, India
          </div>
          <div style="font-family: var(--font-mono); font-size: 0.88rem; color: var(--text-muted);">
            GPA: 8.52 / 10.0
          </div>
        </div>
      </section>

      <!-- VERIFIED CREDENTIALS -->
      <section class="resume-section">
        <h3 class="resume-section-title">VERIFIED CREDENTIALS & PROFILES</h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1rem; margin-top: 1rem;">
          <a href="https://skillsprofile.skillbuilder.aws/user/mausamgiri" target="_blank" rel="noopener noreferrer" class="proof-card" style="padding: 1.25rem;">
            <div style="font-weight: 700; color: var(--accent-gold); margin-bottom: 0.25rem;">AWS Skills Profile</div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Official AWS Skill Builder Verified Record →</div>
          </a>

          <a href="https://credly.com/users/mausam-giri/badges" target="_blank" rel="noopener noreferrer" class="proof-card" style="padding: 1.25rem;">
            <div style="font-weight: 700; color: var(--accent-gold); margin-bottom: 0.25rem;">Credly Digital Badges</div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Cryptographically verified industry badges →</div>
          </a>

          <a href="https://github.com/mausam-giri" target="_blank" rel="noopener noreferrer" class="proof-card" style="padding: 1.25rem;">
            <div style="font-weight: 700; color: var(--accent-gold); margin-bottom: 0.25rem;">GitHub (@mausam-giri)</div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Open source code & Radix UI contributions →</div>
          </a>

          <a href="https://linkedin.com/in/mausamgiri" target="_blank" rel="noopener noreferrer" class="proof-card" style="padding: 1.25rem;">
            <div style="font-weight: 700; color: var(--accent-gold); margin-bottom: 0.25rem;">LinkedIn Professional Profile</div>
            <div style="font-size: 0.85rem; color: var(--text-secondary);">Recommendations, network & verified career →</div>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>
