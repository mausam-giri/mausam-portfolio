---
import { person } from "../data/site";
import Icons from "./Icons.astro";
---

<div class="info-col">
    <h2 class="kicker">Contact</h2>
    <div>
        <a
            class="contact-item"
            href={person.linkedin}
            target="_blank"
            rel="noopener noreferrer"
        >
            <Icons name="linkedin" />
            mausamgiri
        </a>
        <a
            class="contact-item"
            href="https://instagram.com/mausamgiri"
            target="_blank"
            rel="noopener noreferrer"
        >
            <Icons name="instagram" />
            mausamgiri
        </a>
        <a
            class="contact-item"
            href={person.github}
            target="_blank"
            rel="noopener noreferrer"
        >
            <Icons name="github" />
            mausam-giri
        </a>
        <a class="contact-item" href={`mailto:${person.email}`}>
            <Icons name="email" />
            Email Me
        </a>
    </div>
</div>
