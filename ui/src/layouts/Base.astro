---
import "../styles/base.css";
import { person } from "../data/site";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  fullWidth?: boolean;
}

const { title, description, fullWidth = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";

const nav = [
  { href: "/about", label: "About" },
  { href: "/projects", label: "Projects" },
  { href: "/competition", label: "Competition" },
  { href: person.blogs, label: "Blogs", external: true },
  { href: person.tools, label: "Tools", external: true },
];

function current(href: string) {
  return path === href || path.startsWith(`${href}/`);
}

const siteUrl = Astro.site
  ? Astro.site.toString().replace(/\/$/, "")
  : "https://mausamgiri.in";
const ogImageUrl = new URL("/mausam_giri.png", siteUrl).toString();

const schemaJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": `${siteUrl}/#person`,
      name: person.name,
      alternateName: [person.shortName, "Mausam Giri"],
      jobTitle: "Cloud Computing & Software Engineer",
      description:
        "WorldSkills Shanghai 2026 Champion in AWS Cloud Computing representing Team India. Software engineer specialized in resilient distributed systems and healthcare infrastructure.",
      url: siteUrl,
      image: ogImageUrl,
      sameAs: [
        person.github,
        person.linkedin,
        person.instagram,
        person.credlyProfile,
        person.aws,
        person.blogs,
        person.tools,
      ],
      alumniOf: {
        "@type": "CollegeOrUniversity",
        name: "Central University of Haryana",
      },
      award: [
        "WorldSkills Shanghai 2026 Champion (AWS Cloud Computing)",
        "Global Skills Challenge Australia 2026 Gold Medalist",
        "IndiaSkills 2026 National Gold Medalist (AWS Cloud Computing)",
        "IndiaSkills 2024 National Bronze Medalist (Web Technologies)",
      ],
      knowsAbout: [
        "Amazon Web Services (AWS)",
        "Cloud Computing Architecture",
        "Multi-Region Topologies",
        "Kubernetes & Amazon EKS",
        "Infrastructure as Code (Terraform, CloudFormation)",
        "Golang",
        "Distributed Systems & High Availability",
        "Electronic Health Records (EHR)",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Mausam Kumar Giri",
      description: description,
      publisher: {
        "@id": `${siteUrl}/#person`,
      },
    },
  ],
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    <meta name="theme-color" content="#0c0e14" />
    <link rel="canonical" href={canonical} />
    <link
      rel="alternate"
      type="text/markdown"
      href="/llms.txt"
      title="LLM Context (llms.txt)"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llm.txt"
      title="LLM Context (llm.txt)"
    />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta
      name="robots"
      content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
    />

    <!-- Favicon -->
    <link rel="icon" type="image/x-icon" href="/mausam_giri.ico" />
    <link rel="shortcut icon" href="/mausamgiri.ico" />

    <!-- Web Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Anton&family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- OpenGraph Tags -->
    <meta property="og:site_name" content="Mausam Kumar Giri" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="1250" />
    <meta
      property="og:image:alt"
      content="Mausam Kumar Giri - WorldSkills Champion & Cloud Computing Engineer"
    />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" is:inline set:html={schemaJson} />
  </head>
  <body>
    <header
      class={`site-header ${isHome ? "header-landing" : "wrap"}`}
      id="site-header"
    >
      <div class={isHome ? "header-landing-inner" : "header-inner"}>
        <a class="brand" href="/" aria-label="Mausam Giri Home">
          <div class="mark brand-logo-frame">
            <img
              src="/mausamgiri_120.png"
              alt="Mausam Giri"
              width="36"
              height="36"
              class="brand-logo-img"
            />
            <div class="brand-logo-grade"></div>
          </div>
          <span class="brand-name">
            {person.shortName}
          </span>
        </a>
        <nav>
          {
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={
                  !item.external && current(item.href) ? "page" : undefined
                }
                target={item.external ? "_blank" : undefined}
                rel={item.external ? "noopener noreferrer" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>
    {
      fullWidth ? (
        <slot />
      ) : (
        <main class="wrap">
          <slot />
        </main>
      )
    }
    <Footer />

    <script is:inline>
      (function () {
        if (typeof window === "undefined") return;
        window.addEventListener("load", function () {
          try {
            const data = {
              path: window.location.pathname,
              referrer: document.referrer || "",
              timezone:
                Intl && Intl.DateTimeFormat
                  ? Intl.DateTimeFormat().resolvedOptions().timeZone
                  : "",
              screen: window.screen
                ? `${window.screen.width}x${window.screen.height}`
                : "",
            };
            const payload = JSON.stringify(data);
            const endpoint = "/api/visit";

            if (navigator.sendBeacon) {
              const blob = new Blob([payload], { type: "application/json" });
              navigator.sendBeacon(endpoint, blob);
            } else {
              fetch(endpoint, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: payload,
                keepalive: true,
              }).catch(function () {});
            }
          } catch (e) {}
        });
      })();
    </script>

    <!-- Header scroll trigger for landing page -->
    <script is:inline>
      (function () {
        const header = document.querySelector(".header-landing");
        if (!header) return;

        let ticking = false;
        function updateHeader() {
          if (window.scrollY > 100) {
            header.classList.add("scrolled");
          } else {
            header.classList.remove("scrolled");
          }
          ticking = false;
        }

        window.addEventListener(
          "scroll",
          function () {
            if (!ticking) {
              window.requestAnimationFrame(updateHeader);
              ticking = true;
            }
          },
          { passive: true },
        );
        updateHeader();
      })();
    </script>
  </body>
</html>
