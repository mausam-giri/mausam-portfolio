---
import Base from "../layouts/Base.astro";
import { person, achievements } from "../data/site";
import Icons from "../components/Icons.astro";

const title = "About — Mausam Kumar Giri";
const description =
  "About Mausam Kumar Giri, software engineer and Team India Cloud Computing Champion at WorldSkills Shanghai 2026. Academic background, engineering philosophy, and experience.";
---

<Base title={title} description={description}>
  <div class="layout about-layout">
    <article class="page-article">
      <div class="about-hero-block">
        <p class="kicker">About Me</p>
        <h1 class="page-title">Mausam Kumar Giri</h1>
        <p class="role-lead">
          Software engineer focused on scalable cloud architecture, healthcare
          systems, and high-availability backend infrastructure.
        </p>
        <!-- <div class="about-hero-actions">
          <a
            href={person.resumeUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="cta-button"
          >
            <span>View Resume / CV</span>
            <Icons name="external" size={13} />
          </a>
          <a href={`mailto:${person.email}`} class="cta-button secondary">
            <span>Email Mausam</span>
          </a>
        </div> -->
      </div>

      <section class="about-section">
        <h2>Engineering Philosophy</h2>
        <p>
          I build systems that have to stay correct while someone is waiting.
          When dealing with electronic health records, patient diagnostics
          dispatch, or multi-provider financial payments, failure isn't an
          option. I adopt a backend-first mindset, focusing on fault isolation,
          idempotent workflows, deterministic latency, and automated recovery.
        </p>
      </section>

      <section class="about-section">
        <h2>The Journey & Foundation</h2>
        <p>
          I combine deep academic foundations in computer science with hands-on
          systems programming and cloud engineering. Early in my journey, I
          participated in IndiaSkills national competition in Cloud Computing,
          where I got selected for the WorldSkills competition. That experience
          ignited a dedicated pursuit of mastery in cloud infrastructure and
          distributed architecture.
        </p>
      </section>

      <section class="about-section">
        <h2>WorldSkills & Competitive Cloud Computing</h2>
        <p>
          In 2026, I earned the Gold Medal at IndiaSkills in AWS Cloud
          Computing, securing the honor to represent India on the world stage.
        </p>
        <div class="about-highlight-box">
          <div class="highlight-badge-col">
            <img
              src="/champion-badge.png"
              alt="WorldSkills Champion"
              class="about-badge-img"
              width="90"
              height="90"
            />
          </div>
          <div>
            <a href={person.credly} class="link-no-underline">
              <h3>WorldSkills Shanghai 2026 — Champion</h3>
              <p>
                Awarded for top-tier excellence in architecting, automating,
                securing, and operating multi-region AWS environments under
                tight, high-pressure constraints.
              </p>
            </a>
          </div>
        </div>
      </section>

      <section class="about-section">
        <h2>Experience</h2>

        <div class="experience-block">
          <div class="exp-header-row">
            <h3>Software Engineer — MantraCare Health</h3>
            <span class="exp-period">Feb 2025 – Present</span>
          </div>
          <p class="exp-location">New Delhi, India</p>
          <ul>
            <li>
              <strong>Electronic Health Records (EHR):</strong> Designed and architected
              high-concurrency EHR infrastructure managing 20,000+ patient records
              with HIPAA compliance, granular role-based access control (RBAC), and
              insurance workflows.
            </li>
            <li>
              <strong>Payment Orchestration:</strong> Built unified payment routing
              supporting Stripe Connect, Razorpay, and Airwallex for cross-border
              patient consultations and marketplace payouts.
            </li>
            <li>
              <strong>Diagnostics Dispatch:</strong> Integrated direct automated order
              dispatch to laboratory networks including Tata 1mg, Healthians, and
              Redcliffe Labs.
            </li>
            <li>
              <strong>Engagement Telemetry:</strong> Scaled reward-based habit engine
              serving 50,000+ active users (+20% sustained engagement).
            </li>
          </ul>
        </div>

        <div class="experience-block">
          <div class="exp-header-row">
            <h3>Machine Learning Research Intern — NIT Kurukshetra</h3>
            <span class="exp-period">Jun 2024 – Aug 2024</span>
          </div>
          <p class="exp-location">Haryana, India</p>
          <ul>
            <li>
              Developed a novel transformer-based cross-domain recommendation
              system resolving the classic "cold-start" problem, leveraging
              transformer embeddings to capture cross-domain semantic
              similarities.
            </li>
            <li>
              Engineered an interactive diagnostic and evaluation web dashboard
              for recommendation benchmarking.
            </li>
          </ul>
        </div>

        <div class="experience-block">
          <div class="exp-header-row">
            <h3>Frontend Web Development Intern — Estrome Technologies</h3>
            <span class="exp-period">Jun 2023 – Aug 2023</span>
          </div>
          <p class="exp-location">Lucknow, India</p>
          <ul>
            <li>
              Developed an enterprise analytics and lead management portal with
              client-side dynamic PDF compilation using background Web Workers
              to maintain 60 FPS UI responsiveness.
            </li>
            <li>
              Improved Core Web Vitals and organic SEO metrics by approximately
              30%.
            </li>
          </ul>
        </div>

        <div>
          <h2>Academic Background</h2>
          <div class="experience-block academic-timeline-entry">
            <div class="exp-header-row">
              <h3>
                B.Tech in Computer Science & Engineering — Central University of
                Haryana
              </h3>
              <span class="exp-period">2021 – 2025</span>
            </div>
            <p class="exp-location">
              GPA: 8.52 / 10.0 · Mahendragarh, Haryana, India
            </p>
            <ul>
              <li>
                <strong>Core Engineering Curriculum:</strong> Rigorous foundation
                in Distributed Systems, Operating Systems, Database Management Systems,
                Computer Networks, and Cloud Infrastructure.
              </li>
              <li>
                <strong>Academic & Competitive Record:</strong> Graduated with an
                8.52 CGPA while concurrently representing Bihar at IndiaSkills and
                earning selection to Team India for WorldSkills Shanghai in Cloud
                Computing.
              </li>
            </ul>
          </div>
        </div>
      </section>

      <section class="about-section">
        <h2>Technical Core</h2>
        <div class="tech-pills-wrap">
          <span class="tech-pill">AWS (Cloud Architecture)</span>
          <span class="tech-pill">Serverless & Lambda</span>
          <span class="tech-pill">API Gateway</span>
          <span class="tech-pill">DynamoDB & Single-Table</span>
          <span class="tech-pill">Transit Gateway & VPC</span>
          <span class="tech-pill">TypeScript & Node.js</span>
          <span class="tech-pill">Next.js & Astro</span>
          <span class="tech-pill">Docker & Microservices</span>
          <span class="tech-pill">Terraform & CloudFormation</span>
          <span class="tech-pill">PostgreSQL & Prisma</span>
        </div>
      </section>

      <div class="page-footer-actions">
        <!-- <a
          href={person.resumeUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="cta-button"
        >
          <span>View Resume / CV</span>
          <Icons name="external" size={14} />
        </a> -->
        <a href="/projects" class="cta-button secondary">
          <span>View Projects</span>
        </a>
        <a href={`mailto:${person.email}`} class="cta-button secondary">
          <span>Contact Me</span>
        </a>
      </div>
    </article>

    <aside class="facts">
      <!-- <div class="aside-profile-card">
        <p class="facts-label">Quick Facts</p>
        <ul class="facts-list">
          <li><strong>Location:</strong> {person.place}</li>
          <li>
            <strong>Education:</strong> B.Tech CSE (8.52 GPA), Central Univ. of Haryana
          </li>
          <li><strong>Role:</strong> Software Engineer</li>
          <li><strong>WorldSkills:</strong> Cloud Computing (Team India)</li>
          <li>
            <strong>Credentials:</strong>
            <a href={person.credly} target="_blank" rel="noopener noreferrer"
              >Credly Verified</a
            >
          </li>
        </ul>
      </div> -->

      <div class="aside-nav-box">
        <p class="facts-label">Explore More</p>
        <ul class="facts-nav-links">
          <!-- <li>
            <a
              href={person.resumeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              Online Resume / CV &rarr;
            </a>
          </li> -->
          <li><a href="/projects">Featured Projects</a></li>
          <li><a href="/competition">Competition Journey</a></li>
          <li>
            <a href={person.blogs} target="_blank" rel="noopener noreferrer"
              >Technical Blogs &rarr;</a
            >
          </li>
          <li>
            <a href={person.tools} target="_blank" rel="noopener noreferrer"
              >Built Tools &rarr;</a
            >
          </li>
        </ul>
      </div>
    </aside>
  </div>
</Base>

<style>
  .about-layout {
    padding: 2.5rem 0 5rem;
  }

  .about-hero-block {
    margin-bottom: 2.5rem;
  }

  .about-hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .about-section {
    margin-bottom: 2.75rem;
  }

  .about-section h2 {
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: 1.55rem;
    font-weight: 600;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--ink);
    margin: 0 0 1rem;
    border-bottom: 1px solid var(--line);
    padding-bottom: 0.5rem;
  }

  .about-section p {
    color: #c5d0d8;
    line-height: 1.7;
    margin: 0 0 1rem;
    font-size: 1.02rem;
  }

  .about-highlight-box {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--raised);
    border: 1px solid rgba(243, 180, 192, 0.3);
    border-radius: 10px;
    margin: 1.5rem 0;
  }

  @media (min-width: 600px) {
    .about-highlight-box {
      flex-direction: row;
      align-items: center;
    }
  }

  .highlight-badge-col {
    flex-shrink: 0;
    display: grid;
    place-items: center;
  }

  .about-badge-img {
    width: 90px;
    height: auto;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.5));
  }

  .about-highlight-box h3 {
    margin: 0 0 0.5rem;
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: 1.35rem;
    font-weight: 600;
    text-transform: uppercase;
    color: var(--accent);
  }

  .about-highlight-box p {
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
    color: #c5d0d8;
  }

  .about-sub-note {
    font-size: 0.82rem !important;
    color: var(--muted) !important;
  }

  .experience-block {
    margin-bottom: 1.75rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px dashed var(--line);
  }

  .experience-block:last-child {
    border-bottom: 0;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .academic-timeline-entry {
    background: rgba(243, 180, 192, 0.02);
    border-left: 2px solid var(--accent);
    padding-left: 1rem;
    border-radius: 0 6px 6px 0;
  }

  .exp-header-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .experience-block h3 {
    margin: 0;
    font-family: "Barlow Condensed", Impact, sans-serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--ink);
  }

  .exp-location {
    margin: 0.15rem 0 0.75rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  .exp-period {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--accent);
    margin: 0.2rem 0 0.25rem;
  }

  .experience-block ul {
    margin: 0;
    padding-left: 1.25rem;
    color: #c5d0d8;
    line-height: 1.65;
  }

  .experience-block li {
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .tech-pills-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
  }

  .tech-pill {
    display: inline-flex;
    padding: 0.4rem 0.85rem;
    background: var(--raised);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    transition: all 0.15s ease;
  }

  .tech-pill:hover {
    border-color: var(--accent);
    color: var(--accent);
  }
</style>
