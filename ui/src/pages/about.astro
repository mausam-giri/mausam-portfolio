---
import Base from "../layouts/Base.astro";
import { person, achievements, works } from "../data/site";
import Icons from "../components/Icons.astro";

const title = "About — Mausam Kumar Giri";
const description =
  "About Mausam Kumar Giri, software engineer and Team India Cloud Computing Champion at WorldSkills Shanghai 2026. Background, engineering philosophy, and journey.";
---

<Base title={title} description={description}>
  <div class="layout about-layout">
    <article class="page-article">
      <div class="about-hero-block">
        <p class="kicker">About Me</p>
        <h1 class="page-title">Mausam Kumar Giri</h1>
        <p class="role-lead">
          Software engineer focused on scalable cloud architecture, healthcare systems, and high-availability backend infrastructure.
        </p>
      </div>

      <section class="about-section">
        <h2>Engineering Philosophy</h2>
        <p>
          I build systems that have to stay correct while someone is waiting. When dealing with electronic health records, patient diagnostics dispatch, or multi-provider financial payments, failure isn't an option. I adopt a backend-first mindset, focusing on fault isolation, idempotent workflows, deterministic latency, and automated recovery.
        </p>
      </section>

      <section class="about-section">
        <h2>The Journey & Background</h2>
        <p>
          Hailing from West Champaran, Bihar, I earned my Bachelor of Technology in Computer Science and Engineering (2021–2025) from the Central University of Haryana with a GPA of 8.52/10.
        </p>
        <p>
          My passion lies at the intersection of distributed systems, cloud computing, and real-world software engineering. Early in my journey, I represented Bihar at the IndiaSkills national competition in Web Technologies, winning a bronze medal. That experience ignited a dedicated pursuit of global mastery in cloud infrastructure.
        </p>
      </section>

      <section class="about-section">
        <h2>WorldSkills & Competitive Cloud Computing</h2>
        <p>
          In 2026, I earned the Gold Medal at IndiaSkills in AWS Cloud Computing, securing the honor to represent India on the world stage.
        </p>
        <div class="about-highlight-box">
          <div class="highlight-badge-col">
            <img
              src="/champion-badge.png"
              alt="WorldSkills Champion"
              class="about-badge-img"
              width="90"
              height="90"
            />
          </div>
          <div>
            <h3>WorldSkills Shanghai 2026 — Champion</h3>
            <p>
              Awarded for top-tier excellence in architecting, automating, securing, and operating multi-region AWS environments under tight, high-pressure constraints.
            </p>
            <p class="about-sub-note">
              Also secured Gold in Cloud Computing at the Global Skills Challenge in Wollongong, Australia (2026).
            </p>
          </div>
        </div>
      </section>

      <section class="about-section">
        <h2>Production Systems & Research</h2>
        <div class="experience-block">
          <h3>Software Engineer — MantraCare (New Delhi)</h3>
          <span class="exp-period">Feb 2025 – Present</span>
          <ul>
            <li>
              <strong>Electronic Health Records (EHR):</strong> Designed and architected high-concurrency EHR infrastructure managing 20,000+ patient records with strict HIPAA compliance, granular role-based access control, and insurance claim workflows.
            </li>
            <li>
              <strong>Payment Orchestration:</strong> Built unified payment routing supporting Stripe Connect, Razorpay, and Airwallex for cross-border patient consultations and marketplace payouts.
            </li>
            <li>
              <strong>Diagnostics Dispatch:</strong> Integrated direct automated order dispatch to laboratory networks including Tata 1mg, Healthians, and Redcliffe Labs.
            </li>
          </ul>
        </div>

        <div class="experience-block">
          <h3>Machine Learning Research Intern — NIT Kurukshetra</h3>
          <span class="exp-period">Jun 2024 – Aug 2024</span>
          <ul>
            <li>
              Developed a novel cross-domain recommendation system resolving the classic "cold-start" problem, leveraging transformer embeddings to capture cross-domain semantic similarities.
            </li>
          </ul>
        </div>
      </section>

      <section class="about-section">
        <h2>Technical Core</h2>
        <div class="tech-pills-wrap">
          <span class="tech-pill">AWS (Cloud Architecture)</span>
          <span class="tech-pill">Serverless & Lambda</span>
          <span class="tech-pill">API Gateway</span>
          <span class="tech-pill">DynamoDB & Single-Table</span>
          <span class="tech-pill">Transit Gateway & VPC</span>
          <span class="tech-pill">TypeScript & Node.js</span>
          <span class="tech-pill">Next.js & Astro</span>
          <span class="tech-pill">Docker & Microservices</span>
          <span class="tech-pill">Terraform & CloudFormation</span>
          <span class="tech-pill">PostgreSQL & Prisma</span>
        </div>
      </section>

      <div class="page-footer-actions">
        <a href="/resume" class="cta-button">View Resume &rarr;</a>
        <a href={`mailto:${person.email}`} class="cta-button secondary">Contact Mausam</a>
      </div>
    </article>

    <aside class="facts">
      <div class="aside-profile-card">
        <p class="facts-label">Quick Facts</p>
        <ul class="facts-list">
          <li><strong>Location:</strong> {person.place}</li>
          <li><strong>Education:</strong> B.Tech CSE, Central Univ. of Haryana</li>
          <li><strong>Role:</strong> Software Engineer</li>
          <li><strong>WorldSkills:</strong> Cloud Computing (India)</li>
          <li><strong>Credentials:</strong> <a href={person.credly} target="_blank" rel="noopener noreferrer">Credly Verified</a></li>
        </ul>
      </div>

      <div class="aside-nav-box">
        <p class="facts-label">Explore More</p>
        <ul class="facts-nav-links">
          <li><a href="/resume">Detailed Resume</a></li>
          <li><a href={person.blogs} target="_blank" rel="noopener noreferrer">Technical Blogs &rarr;</a></li>
          <li><a href={person.tools} target="_blank" rel="noopener noreferrer">Built Tools &rarr;</a></li>
          <li><a href="/competition">Competition Journey</a></li>
        </ul>
      </div>
    </aside>
  </div>
</Base>
