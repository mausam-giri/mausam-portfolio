---
import Base from "../layouts/Base.astro";
import { person } from "../data/site";
import { Image } from "astro:assets";
import heroImage from "../assets/worldskills_mausamgiri_3.png";
import PersonalCard from "../components/PersonalCard.astro";
import AchievementsCard from "../components/AchievementsCard.astro";
import BlogsCard from "../components/BlogsCard.astro";
import ToolsCard from "../components/ToolsCard.astro";
import ContactCard from "../components/ContactCard.astro";

const title = "Mausam Kumar Giri — Software Engineer & Cloud Computing Champion";
const description =
  "Mausam Kumar Giri is a software engineer from West Champaran, Bihar. WorldSkills Shanghai 2026 Champion in Cloud Computing representing Team India. Electronic health records and payment systems engineer.";
---

<Base title={title} description={description} fullWidth={true}>
  <!-- Hero Section -->
  <section class="hero" aria-label={person.name}>
    <Image
      class="hero-sharp"
      src={heroImage}
      alt="Mausam Kumar Giri representing Team India in Cloud Computing at WorldSkills"
      width={1600}
      height={1200}
      loading="eager"
    />
    <div class="hero-grade"></div>
    <div class="hero-copy">
      <p class="hero-nation">
        <img
          src="/flag_of_india.svg"
          alt="India Flag"
          class="hero-flag"
          width="24"
          height="16"
        />
        Republic of India
      </p>
      <h1>
        <span class="line-first">Mausam</span>
        <span class="accent">Giri</span>
      </h1>
    </div>
    <div class="hero-bar">
      <div>
        <span class="hero-bar-box">Cloud Computing</span>
        <span class="hero-bar-box">Team India</span>
      </div>
      <span class="hero-bar-box hero-bar-box-right">
        WorldSkills Shanghai 2026 Champion
      </span>
    </div>
  </section>

  <!-- Lede Bio Section -->
  <section class="wrap">
    <div class="lede">
      <p>
        I build systems that have to stay correct while someone is waiting.
        Cloud Computing-focused Software Engineer & WorldSkills Champion.
      </p>
      <p class="actions">
        <a href="/about">About</a>
        <a href="/resume">Resume</a>
        <a href={`mailto:${person.email}`}>Email</a>
        <a href={person.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href={person.blogs} target="_blank" rel="noopener noreferrer">Blogs</a>
      </p>
    </div>
  </section>

  <!-- Main Content Layout (Main Cards + Aside) -->
  <section class="wrap content-layout">
    <main class="cards-stream">
      <!-- 1. Personal Navigation & Overview -->
      <PersonalCard />

      <!-- 2. Achievement Section Showcase -->
      <AchievementsCard />

      <!-- 3. Top 6 Technical Blogs + More Button -->
      <BlogsCard />

      <!-- 4. Built Tools & Utilities -->
      <ToolsCard />
    </main>

    <!-- Sidebar Aside: Contact & Status -->
    <aside class="aside-stream">
      <ContactCard />
    </aside>
  </section>

  <!-- Schema.org Structured Data -->
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: person.name,
      alternateName: person.shortName,
      url: person.site,
      jobTitle: "Software Engineer",
      email: person.email,
      homeLocation: "West Champaran, Bihar, India",
      sameAs: [
        person.linkedin,
        person.github,
        person.instagram,
        person.blogs,
        person.tools,
        person.credly,
        person.aws,
      ],
      award: [
        "WorldSkills Shanghai 2026 Champion - Cloud Computing",
        "Global Skills Challenge Australia 2026 Gold Medalist",
        "IndiaSkills 2026 Gold Medalist",
        "IndiaSkills 2024 Bronze Medalist",
      ],
    })}
  />
</Base>
